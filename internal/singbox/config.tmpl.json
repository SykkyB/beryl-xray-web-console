{
  "log": {
    "level": "info",
    "timestamp": true,
    "output": "/var/log/sing-box.log"
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "proxy-dns",
        "server": "1.1.1.1",
        "server_port": 53,
        "detour": "proxy"
      },
      {
        "type": "udp",
        "tag": "local-dns",
        "server": "127.0.0.1",
        "server_port": 53
      }
    ],
    "rules": [
      {
        "domain": [{{range $i, $s := .Servers}}{{if $i}}, {{end}}{{json $s}}{{end}}],
        "server": "local-dns"
      }
    ],
    "final": "proxy-dns",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sing-tun",
      "address": ["172.19.0.1/30"],
      "mtu": 1400,
      "auto_route": true,
      "strict_route": true,
      "stack": "gvisor"
    }
  ],
  "outbounds": [
    {{range $i, $p := .Profiles}}{{if $i}},
    {{end}}{
      "type": "vless",
      "tag": {{json $p.Tag}},
      "server": {{json $p.Server}},
      "server_port": {{$p.Port}},
      "uuid": {{json $p.UUID}},
      "flow": {{json $p.Flow}},
      "tls": {
        "enabled": true,
        "server_name": {{json $p.SNI}},
        "utls": {
          "enabled": true,
          "fingerprint": {{json $p.Fingerprint}}
        }{{if $p.IsReality}},
        "reality": {
          "enabled": true,
          "public_key": {{json $p.PublicKey}},
          "short_id": {{json $p.ShortID}}
        }{{end}}
      }{{if $p.IsWS}},
      "transport": {
        "type": "ws",
        "path": {{json $p.Path}}{{if $p.Host}},
        "headers": { "Host": {{json $p.Host}} }{{end}}
      }{{end}}
    }{{end}},
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [{{range $i, $p := .Profiles}}{{if $i}}, {{end}}{{json $p.Tag}}{{end}}],
      "default": {{json .ActiveTag}},
      "interrupt_exist_connections": true
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "local-dns"
    },
    "rules": [
      { "action": "sniff" },
      { "ip_is_private": true, "outbound": "direct" },
      { "protocol": "dns", "action": "hijack-dns" }
    ],
    "auto_detect_interface": true,
    "final": "proxy"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "default_mode": "rule"
    }
  }
}
