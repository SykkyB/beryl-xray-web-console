{
  "log": {
    "level": "info",
    "timestamp": true,
    "output": "/var/log/sing-box.log"
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "proxy-dns",
        "server": "1.1.1.1",
        "server_port": 53,
        "detour": "proxy"
      },
      {
        "type": "udp",
        "tag": "local-dns",
        "server": "127.0.0.1",
        "server_port": 53
      }
    ],
    "rules": [
      {
        "domain": [{{json .Server}}],
        "server": "local-dns"
      }
    ],
    "final": "proxy-dns",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sing-tun",
      "address": ["172.19.0.1/30"],
      "mtu": 1400,
      "auto_route": true,
      "strict_route": true,
      "stack": "gvisor"
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": {{json .Server}},
      "server_port": {{.Port}},
      "uuid": {{json .UUID}},
      "flow": {{json .Flow}},
      "tls": {
        "enabled": true,
        "server_name": {{json .SNI}},
        "utls": {
          "enabled": true,
          "fingerprint": {{json .Fingerprint}}
        },
        "reality": {
          "enabled": true,
          "public_key": {{json .PublicKey}},
          "short_id": {{json .ShortID}}
        }
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "local-dns"
    },
    "rules": [
      { "action": "sniff" },
      { "ip_is_private": true, "outbound": "direct" },
      { "protocol": "dns", "action": "hijack-dns" }
    ],
    "auto_detect_interface": true,
    "final": "proxy"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "default_mode": "rule"
    }
  }
}
