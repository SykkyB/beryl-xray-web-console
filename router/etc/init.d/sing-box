#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15

PROG=/usr/bin/sing-box
CONFIG_DIR=/etc/sing-box
CONFIG=$CONFIG_DIR/config.json
UCI_CFG=sing-box

TUN_TABLE=2022
TUN_IF=sing-tun
LAN_IF=br-lan
RULE_PRIO_VPN=5000
RULE_PRIO_KILL=5500

uci_get_bool() {
	local v
	v=$(uci -q get "$UCI_CFG.config.$1") || v="$2"
	[ "$v" = "1" ] && echo 1 || echo 0
}

apply_lan_routing() {
	local i=0
	while [ $i -lt 15 ]; do
		ip link show "$TUN_IF" >/dev/null 2>&1 && break
		sleep 1
		i=$((i+1))
	done

	ip rule del priority "$RULE_PRIO_VPN" 2>/dev/null
	ip rule add iif "$LAN_IF" lookup "$TUN_TABLE" priority "$RULE_PRIO_VPN"

	iptables -D FORWARD -i "$LAN_IF" -o "$TUN_IF" -j ACCEPT 2>/dev/null
	iptables -D FORWARD -i "$TUN_IF" -o "$LAN_IF" -j ACCEPT 2>/dev/null
	iptables -D FORWARD -i "$LAN_IF" -o "$TUN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
	iptables -D FORWARD -i "$TUN_IF" -o "$LAN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null

	iptables -I FORWARD 1 -i "$LAN_IF" -o "$TUN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
	iptables -I FORWARD 1 -i "$TUN_IF" -o "$LAN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
	iptables -I FORWARD 1 -i "$LAN_IF" -o "$TUN_IF" -j ACCEPT
	iptables -I FORWARD 1 -i "$TUN_IF" -o "$LAN_IF" -j ACCEPT
}

remove_lan_routing() {
	ip rule del priority "$RULE_PRIO_VPN" 2>/dev/null

	iptables -D FORWARD -i "$LAN_IF" -o "$TUN_IF" -j ACCEPT 2>/dev/null
	iptables -D FORWARD -i "$TUN_IF" -o "$LAN_IF" -j ACCEPT 2>/dev/null
	iptables -D FORWARD -i "$LAN_IF" -o "$TUN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
	iptables -D FORWARD -i "$TUN_IF" -o "$LAN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
}

apply_killswitch_state() {
	local on
	on=$(uci_get_bool killswitch 0)
	ip rule del priority "$RULE_PRIO_KILL" 2>/dev/null
	[ "$on" = "1" ] && ip rule add iif "$LAN_IF" blackhole priority "$RULE_PRIO_KILL"
}

start_service() {
	local enabled bind_sw sw_func sw_status bound
	enabled=$(uci_get_bool enabled 1)
	[ "$enabled" = "0" ] && return 1

	# Two signals that the physical toggle is bound to us:
	#   1. UCI switch-button.@main[0].func == "xray"
	#      (set by the dashboard launcher's btnsettings injection)
	#   2. Legacy: UCI sing-box.config.bind_switch == 1
	#      (predates Phase 4; kept so rollback to launcher mode=legacy
	#      preserves prior behaviour without UCI migration)
	bind_sw=$(uci_get_bool bind_switch 0)
	sw_func=$(uci -q get switch-button.@main[0].func 2>/dev/null)
	bound=0
	[ "$sw_func" = "xray" ] && bound=1
	[ "$bind_sw" = "1" ] && bound=1

	if [ "$bound" = "1" ] && [ -r /lib/functions/gl_util.sh ]; then
		sw_status=$(. /lib/functions/gl_util.sh; get_switch_button_status 2>/dev/null)
		[ "$sw_status" = "off" ] && {
			logger -t sing-box "bound to physical switch and it is OFF — not starting"
			return 1
		}
	fi

	[ ! -x "$PROG" ] && return 1
	[ ! -f "$CONFIG" ] && return 1
	"$PROG" check -c "$CONFIG" || return 1

	procd_open_instance "sing-box"
	procd_set_param command "$PROG" -D "$CONFIG_DIR" run -c "$CONFIG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="65536 65536"
	procd_close_instance

	apply_lan_routing
	apply_killswitch_state
}

stop_service() {
	remove_lan_routing
	# killswitch state stays as configured in UCI;
	# it is independent of sing-box service state.
	apply_killswitch_state
}

reload_service() {
	"$PROG" check -c "$CONFIG" || return 1
	stop
	sleep 1
	start
}

service_triggers() {
	procd_add_reload_trigger "$UCI_CFG"
}

killswitch_on() {
	uci -q set "$UCI_CFG.config.killswitch=1"
	uci commit "$UCI_CFG"
	apply_killswitch_state
	echo "killswitch: on (LAN traffic will be dropped when tunnel is down)"
}

killswitch_off() {
	uci -q set "$UCI_CFG.config.killswitch=0"
	uci commit "$UCI_CFG"
	apply_killswitch_state
	echo "killswitch: off (LAN traffic will fall back to direct WAN when tunnel is down)"
}

killswitch_status() {
	local on
	on=$(uci_get_bool killswitch 0)
	[ "$on" = "1" ] && echo "killswitch: on" || echo "killswitch: off"
}

bind_switch_on() {
	uci -q set "$UCI_CFG.config.bind_switch=1"
	uci commit "$UCI_CFG"
	echo "bind_switch: on (sing-box now follows the physical mode switch)"

	# Sync to current physical position immediately.
	local sw_status
	[ -r /lib/functions/gl_util.sh ] && \
		sw_status=$(. /lib/functions/gl_util.sh; get_switch_button_status 2>/dev/null)

	case "$sw_status" in
		on)
			BUTTON=switch ACTION=pressed  /etc/hotplug.d/button/50-sing-box-switch
			;;
		off)
			BUTTON=switch ACTION=released /etc/hotplug.d/button/50-sing-box-switch
			;;
	esac
}

bind_switch_off() {
	uci -q set "$UCI_CFG.config.bind_switch=0"
	uci commit "$UCI_CFG"
	echo "bind_switch: off (sing-box ignores the physical mode switch)"
}

bind_switch_status() {
	local on sw
	on=$(uci_get_bool bind_switch 0)
	[ -r /lib/functions/gl_util.sh ] && \
		sw=$(. /lib/functions/gl_util.sh; get_switch_button_status 2>/dev/null)
	[ "$on" = "1" ] && echo "bind_switch: on" || echo "bind_switch: off"
	[ -n "$sw" ] && echo "physical switch: $sw"
}

EXTRA_COMMANDS="killswitch_on killswitch_off killswitch_status bind_switch_on bind_switch_off bind_switch_status"
EXTRA_HELP="	killswitch_on        Enable killswitch (drop LAN if tunnel down)
	killswitch_off       Disable killswitch (LAN falls back to direct WAN)
	killswitch_status    Show current killswitch state
	bind_switch_on       Bind sing-box to GL.iNet physical mode switch
	bind_switch_off      Unbind from physical switch
	bind_switch_status   Show bind_switch + current switch position"
