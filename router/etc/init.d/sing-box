#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15

PROG=/usr/bin/sing-box
CONFIG_DIR=/etc/sing-box
CONFIG=$CONFIG_DIR/config.json
UCI_CFG=sing-box

TUN_TABLE=2022
TUN_IF=sing-tun
LAN_IF=br-lan
RULE_PRIO_VPN=5000
RULE_PRIO_KILL=5500

uci_get_bool() {
	local v
	v=$(uci -q get "$UCI_CFG.config.$1") || v="$2"
	[ "$v" = "1" ] && echo 1 || echo 0
}

apply_lan_routing() {
	local i=0
	while [ $i -lt 15 ]; do
		ip link show "$TUN_IF" >/dev/null 2>&1 && break
		sleep 1
		i=$((i+1))
	done

	ip rule del priority "$RULE_PRIO_VPN" 2>/dev/null
	ip rule add iif "$LAN_IF" lookup "$TUN_TABLE" priority "$RULE_PRIO_VPN"

	iptables -D FORWARD -i "$LAN_IF" -o "$TUN_IF" -j ACCEPT 2>/dev/null
	iptables -D FORWARD -i "$TUN_IF" -o "$LAN_IF" -j ACCEPT 2>/dev/null
	iptables -D FORWARD -i "$LAN_IF" -o "$TUN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
	iptables -D FORWARD -i "$TUN_IF" -o "$LAN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null

	iptables -I FORWARD 1 -i "$LAN_IF" -o "$TUN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
	iptables -I FORWARD 1 -i "$TUN_IF" -o "$LAN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
	iptables -I FORWARD 1 -i "$LAN_IF" -o "$TUN_IF" -j ACCEPT
	iptables -I FORWARD 1 -i "$TUN_IF" -o "$LAN_IF" -j ACCEPT
}

remove_lan_routing() {
	ip rule del priority "$RULE_PRIO_VPN" 2>/dev/null

	iptables -D FORWARD -i "$LAN_IF" -o "$TUN_IF" -j ACCEPT 2>/dev/null
	iptables -D FORWARD -i "$TUN_IF" -o "$LAN_IF" -j ACCEPT 2>/dev/null
	iptables -D FORWARD -i "$LAN_IF" -o "$TUN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
	iptables -D FORWARD -i "$TUN_IF" -o "$LAN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
}

apply_killswitch_state() {
	local on
	on=$(uci_get_bool killswitch 0)
	ip rule del priority "$RULE_PRIO_KILL" 2>/dev/null
	[ "$on" = "1" ] && ip rule add iif "$LAN_IF" blackhole priority "$RULE_PRIO_KILL"
}

start_service() {
	local enabled bind_sw sw_func sw_status bound
	enabled=$(uci_get_bool enabled 1)
	[ "$enabled" = "0" ] && return 1

	# Two signals that the physical toggle is bound to us:
	#   1. UCI switch-button.@main[0].func == "xray"
	#      (set by the dashboard launcher's btnsettings injection)
	#   2. Legacy: UCI sing-box.config.bind_switch == 1
	#      (predates Phase 4; kept so rollback to launcher mode=legacy
	#      preserves prior behaviour without UCI migration)
	bind_sw=$(uci_get_bool bind_switch 0)
	sw_func=$(uci -q get switch-button.@main[0].func 2>/dev/null)
	bound=0
	[ "$sw_func" = "xray" ] && bound=1
	[ "$bind_sw" = "1" ] && bound=1

	# Boot-time gate (Phase 5d-fix): if Side switch is NOT claimed for
	# XRAY, refuse to autostart at boot. Stock vpn-client will bring
	# wgclient1 / ovpnclient1 up per route_policy and own LAN routing
	# uncontested — matching what the user sees in the dashboard's
	# Side switch selector position ("WireGuard VPN" side).
	#
	# Runtime UI starts (POST /api/service start from a dashboard
	# click) still work even with bind_switch=0; we differentiate via
	# uptime — procd fires this within the first ~30s of boot, UI
	# clicks happen well after the 120s gate.
	if [ "$bound" != "1" ]; then
		local uptime_s
		uptime_s=$(awk '{printf "%d", $1}' /proc/uptime 2>/dev/null)
		if [ "${uptime_s:-9999}" -lt 120 ]; then
			logger -t sing-box "boot gate: Side switch not bound to XRAY (bind_switch=$bind_sw func=$sw_func) — not starting at boot"
			return 1
		fi
	fi

	if [ "$bound" = "1" ] && [ -r /lib/functions/gl_util.sh ]; then
		sw_status=$(. /lib/functions/gl_util.sh; get_switch_button_status 2>/dev/null)
		[ "$sw_status" = "off" ] && {
			logger -t sing-box "bound to physical switch and it is OFF — not starting"
			return 1
		}
	fi

	[ ! -x "$PROG" ] && return 1
	[ ! -f "$CONFIG" ] && return 1
	"$PROG" check -c "$CONFIG" || return 1

	# Boot-time mutex (Phase 5d) — fires ONLY when the user has bound
	# XRAY to the Side switch (bind_switch=1 or func=xray). Without
	# the bound gate, we used to kill native unconditionally; the user
	# saw WG go down even when they'd set Side switch = "WireGuard VPN"
	# expecting WG to win.
	#
	# Records what we disabled in sing-box.config.native_vpn_disabled
	# so /api/native-vpn/restore (called when the user clicks XRAY OFF
	# in the dashboard, or via Side-switch → WireGuard) puts it back
	# exactly as it was.
	if [ "$bound" = "1" ]; then
		stop_native_vpns
		apply_native_disabled_memo
	fi

	procd_open_instance "sing-box"
	procd_set_param command "$PROG" -D "$CONFIG_DIR" run -c "$CONFIG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="65536 65536"
	procd_close_instance

	apply_lan_routing
	apply_killswitch_state
}

# stop_native_vpns iterates UCI route_policy and disables any
# wireguard/openvpn rule that is currently enabled. Same algorithm as
# internal/http/native_vpn.go stopNativeVPN — keep behaviour identical
# so a reboot-time stop and a runtime stop produce the same UCI state.
# Idempotent: no-op when nothing native is enabled.
NATIVE_DISABLED=""
stop_native_vpns() {
	NATIVE_DISABLED=""
	local sections rule via_type ena
	sections=$(uci -q show route_policy 2>/dev/null | awk -F'[.=]' '/\.enabled=/{print $1"."$2}' | sort -u)
	for rule in $sections; do
		via_type=$(uci -q get "${rule}.via_type" 2>/dev/null)
		ena=$(uci -q get "${rule}.enabled" 2>/dev/null)
		[ "$ena" = "1" ] || continue
		case "$via_type" in
			wireguard|openvpn)
				uci -q set "${rule}.enabled=0"
				NATIVE_DISABLED="${NATIVE_DISABLED}${NATIVE_DISABLED:+,}${rule}"
				;;
		esac
	done
	if [ -n "$NATIVE_DISABLED" ]; then
		uci commit route_policy
		# Restart vpn-client so it tears down ifaces we just disabled.
		# Async + redirected so a slow restart can't stall sing-box start.
		(/etc/init.d/vpn-client restart >/dev/null 2>&1 &)
		logger -t sing-box "boot mutex: disabled native VPN rules [$NATIVE_DISABLED]"
	fi
}

# apply_native_disabled_memo persists the boot-time mutex result so
# /api/native-vpn/restore (called by XRAY OFF in the dashboard) can put
# the rules back exactly as they were. Mirrors what stopNativeVPN does
# in the HTTP handler. Skips when nothing was disabled this run AND a
# prior memo already exists (don't clobber a runtime mutex state).
apply_native_disabled_memo() {
	[ -z "$NATIVE_DISABLED" ] && return
	uci -q set "$UCI_CFG.config.native_vpn_disabled=$NATIVE_DISABLED"
	uci commit "$UCI_CFG"
}

stop_service() {
	remove_lan_routing
	# killswitch state stays as configured in UCI;
	# it is independent of sing-box service state.
	apply_killswitch_state
}

reload_service() {
	"$PROG" check -c "$CONFIG" || return 1
	stop
	sleep 1
	start
}

service_triggers() {
	procd_add_reload_trigger "$UCI_CFG"
}

killswitch_on() {
	uci -q set "$UCI_CFG.config.killswitch=1"
	uci commit "$UCI_CFG"
	apply_killswitch_state
	echo "killswitch: on (LAN traffic will be dropped when tunnel is down)"
}

killswitch_off() {
	uci -q set "$UCI_CFG.config.killswitch=0"
	uci commit "$UCI_CFG"
	apply_killswitch_state
	echo "killswitch: off (LAN traffic will fall back to direct WAN when tunnel is down)"
}

killswitch_status() {
	local on
	on=$(uci_get_bool killswitch 0)
	[ "$on" = "1" ] && echo "killswitch: on" || echo "killswitch: off"
}

bind_switch_on() {
	uci -q set "$UCI_CFG.config.bind_switch=1"
	uci commit "$UCI_CFG"
	echo "bind_switch: on (sing-box now follows the physical mode switch)"

	# Sync to current physical position immediately.
	local sw_status
	[ -r /lib/functions/gl_util.sh ] && \
		sw_status=$(. /lib/functions/gl_util.sh; get_switch_button_status 2>/dev/null)

	case "$sw_status" in
		on)
			BUTTON=switch ACTION=pressed  /etc/hotplug.d/button/50-sing-box-switch
			;;
		off)
			BUTTON=switch ACTION=released /etc/hotplug.d/button/50-sing-box-switch
			;;
	esac
}

bind_switch_off() {
	uci -q set "$UCI_CFG.config.bind_switch=0"
	uci commit "$UCI_CFG"
	echo "bind_switch: off (sing-box ignores the physical mode switch)"
}

bind_switch_status() {
	local on sw
	on=$(uci_get_bool bind_switch 0)
	[ -r /lib/functions/gl_util.sh ] && \
		sw=$(. /lib/functions/gl_util.sh; get_switch_button_status 2>/dev/null)
	[ "$on" = "1" ] && echo "bind_switch: on" || echo "bind_switch: off"
	[ -n "$sw" ] && echo "physical switch: $sw"
}

EXTRA_COMMANDS="killswitch_on killswitch_off killswitch_status bind_switch_on bind_switch_off bind_switch_status"
EXTRA_HELP="	killswitch_on        Enable killswitch (drop LAN if tunnel down)
	killswitch_off       Disable killswitch (LAN falls back to direct WAN)
	killswitch_status    Show current killswitch state
	bind_switch_on       Bind sing-box to GL.iNet physical mode switch
	bind_switch_off      Unbind from physical switch
	bind_switch_status   Show bind_switch + current switch position"
